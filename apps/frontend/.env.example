# ──────────────────────────────────────
# Recro AI — Local Development & Self-Hosting
# ──────────────────────────────────────
# Copy this file to .env and adjust as needed.

# ── LLM Provider ─────────────────────
# Default: OpenAI (works on Vercel and locally).
# Alternatives: anthropic, openrouter, gemini, deepseek, ollama, openai_compatible
# On Vercel, set these as Environment Variables in the dashboard for persistence.
LLM_PROVIDER=openai

# Default model. For OpenAI: gpt-4o-mini works on all plans.
LLM_MODEL=gpt-4o-mini

# API key — required for cloud providers (OpenAI, Anthropic, etc.)
# When set as a Vercel Environment Variable, it takes priority over Settings UI.
# LLM_API_KEY=

# API base URL. Leave blank for OpenAI / Anthropic / etc.
# For Ollama: http://localhost:11434
# For a local vLLM/LM Studio server: http://localhost:1234/v1
# LLM_API_BASE=

# ── Supabase ──────────────────────────
# Required for data storage. Sign up at https://supabase.com (free tier).
# Create a project, then copy your URL and anon/publishable key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Frontend Base URL ────────────────
# Used by the backend to construct PDF print URLs.
# Locally this is the Next.js dev server.
FRONTEND_BASE_URL=http://localhost:3000

# ── Backend Server ───────────────────
HOST=0.0.0.0
PORT=8000
