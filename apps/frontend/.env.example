# ──────────────────────────────────────
# Recro AI — Local Development & Self-Hosting
# ──────────────────────────────────────
# Copy this file to .env and adjust as needed.
# The defaults work with Ollama (free, local LLM) + Supabase free tier.

# ── LLM Provider ─────────────────────
# Default: Ollama (free, runs locally on port 11434)
# Alternatives: openai, anthropic, openrouter, gemini, deepseek, openai_compatible
LLM_PROVIDER=ollama

# Default model for Ollama. Change to any model you've pulled.
LLM_MODEL=llama3.2

# API key — only needed for cloud providers (OpenAI, Anthropic, etc.)
# Ollama and local servers don't need this.
# LLM_API_KEY=

# API base URL. Ollama default: http://localhost:11434
# For OpenAI: https://api.openai.com/v1
# For a local vLLM/LM Studio server: http://localhost:1234/v1
LLM_API_BASE=http://localhost:11434

# ── Supabase ──────────────────────────
# Required for data storage. Sign up at https://supabase.com (free tier).
# Create a project, then copy your URL and anon/publishable key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Frontend Base URL ────────────────
# Used by the backend to construct PDF print URLs.
# Locally this is the Next.js dev server.
FRONTEND_BASE_URL=http://localhost:3000

# ── Backend Server ───────────────────
HOST=0.0.0.0
PORT=8000
